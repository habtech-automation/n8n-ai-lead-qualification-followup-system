      "parameters": {
        "jsCode": "// Access the AI output and the original lead data\nconst aiResponse = $node[\"Score & Write Email\"].json.content.parts[0].text;\nconst lead = $('New Lead (Google Sheets)').item.json;\n\n// Use regex to extract the JSON content from the Markdown blocks (```json ... ```)\nconst jsonString = aiResponse.replace(/```json|```/g, \"\").trim();\n\ntry {\n  // Parse the extracted string into a real object\n  const aiData = JSON.parse(jsonString);\n\n  return [{\n    json: {\n      name: lead.name,\n      email: lead.email,\n      company: lead.company,\n      job_title: lead.job_title,\n      phone: lead.phone || '',\n      // Map fields from the AI's parsed JSON\n      score: aiData.score,\n      tier: aiData.tier,\n      email_subject: aiData.subject,\n      email_body: aiData.body,\n      created_at: new Date().toISOString()\n    }\n  }];\n} catch (error) {\n  // Fallback in case the AI output isn't valid JSON\n  return [{\n    json: {\n      error: \"Failed to parse AI response\",\n      raw_text: aiResponse\n    }\n  }];\n}"
      },
