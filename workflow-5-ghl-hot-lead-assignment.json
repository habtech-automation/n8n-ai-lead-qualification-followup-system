    {
      "parameters": {
        "jsCode": "// EDIT THIS LIST: your sales reps for round-robin assignment\nconst reps = [\n  { name: \"Rep One\", email: \"rep1@example.com\", phone: \"+10000000001\" },\n  { name: \"Rep Two\", email: \"rep2@example.com\", phone: \"+10000000002\" },\n  { name: \"Rep Three\", email: \"rep3@example.com\", phone: \"+10000000003\" }\n];\n\nconst staticData = $getWorkflowStaticData('global');\nif (staticData.repIndex === undefined || staticData.repIndex === null) {\n  staticData.repIndex = 0;\n}\n\nconst assignedRep = reps[staticData.repIndex % reps.length];\nstaticData.repIndex += 1;\n\nreturn items.map(item => {\n  item.json.assignedRepName = assignedRep.name;\n  item.json.assignedRepEmail = assignedRep.email;\n  item.json.assignedRepPhone = assignedRep.phone;\n  item.json.assignedAt = new Date().toISOString();\n  item.json.repTag = 'assigned-' + assignedRep.name.toLowerCase().replace(/ /g, '-');\n  return item;\n});"
      },
