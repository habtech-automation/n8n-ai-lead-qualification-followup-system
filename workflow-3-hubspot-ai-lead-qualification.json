    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead Details:\nName: {{ $json.firstName }} {{ $json.lastName }}\nCompany: {{ $json.company }}\nSource: {{ $json.source }}\nService Interested: {{ $json.serviceInterested }}\nMessage: \"{{ $json.message }}\"\n\nClassify this lead.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a B2B lead qualification specialist for a marketing agency using HubSpot. Analyze each lead strictly on the evidence provided.\n\nClassify as HOT only when the message shows explicit purchase or service intent (e.g. \"I need this now\", \"ready to start\", \"looking to hire\") combined with an urgency signal (timeframe, deadline, \"asap\") or budget signal (budget mentioned, stated willingness to invest, serious pricing inquiry).\n\nClassify as WARM when there is genuine relevant interest but no explicit urgency or budget signal.\n\nClassify as COLD when the message is vague, purely informational, generic, or shows no real buying intent.\n\nBe conservative — only assign HOT when the evidence clearly supports it. Always return valid structured output."
        }
      },
      "id": "f6d8f29e-846e-4376-b066-23386e1051bc",
      "name": "AI Qualification Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        6608,
        2000
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"qualificationStatus\": \"Hot\",\n  \"leadScore\": 85,\n  \"reasoning\": \"Explicit budget ($3,500) and clear service intent for patient bookings within 30 days.\",\n  \"nextAction\": \"Call Now\"\n}"
      },
      "id": "8e3a6955-d209-4b19-bc20-1020b305045b",
